@using ManagedBackgroundServices.Abstractions
@using ManagedBackgroundServices.Abstractions.Infrastructure
@using ManagedBackgroundServices.Abstractions.Logging
@using ManagedBackgroundServices.Abstractions.Queues
@using ManagedBackgroundServices.Abstractions.Scheduling
@using Microsoft.Extensions.Logging
@inject IManagedBackgroundServiceProvider BackgroundServices
@inject IInMemoryLogQuery LogQuery
@inject IScheduledJobRegistry? ScheduledJobRegistry

@if (_logsByHandlerName is null) return;

<table class="mbs-dashboard-table">
    <thead>
        <tr>
            <th></th>
            <th>Service</th>
            <th>Status</th>
            <th>Controls</th>
            <th></th>            
            <th>Exception</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var svc in BackgroundServices.Services)
        {
            var handlerIdentifier = svc.HandlerIdentifier;
            var isExpanded = _expandedServiceNames.Contains(handlerIdentifier);

            <tr>
                <td>
                    <button class="mbs-btn mbs-expand-btn" @onclick="() => ToggleLogs(handlerIdentifier)">@(isExpanded ? "Hide" : "Show") logs</button>
                </td>
                <td>
                    <span class="mbs-service-icon" title="@GetServiceTypeLabel(svc)" aria-label="@GetServiceTypeLabel(svc)">@GetServiceTypeIcon(svc)</span>
                    <span>@handlerIdentifier</span>
                    @{
                        var jobPattern = GetScheduledJobPattern(handlerIdentifier);
                        if (jobPattern is not null)
                        {
                            <br />
                            <span class="small">@FormatRecurrencePattern(jobPattern)</span>
                        }
                    }
                </td>
                <td>
                    <span class="mbs-status-chip @GetStatusCssClass(svc.Status)">
                        <span class="mbs-status-icon" aria-hidden="true">@GetStatusIcon(svc.Status)</span>
                        @svc.Status
                    </span>

                    @if (svc is IQueueConsumerPerformance queueSvc)
                    {
                        <br />
                        <span class="small">@queueSvc.ConsumeRate.ToString("n1") / @TimeSpanExpression(queueSvc.ConsumeRateSpan)</span>
                    }


                    @if (svc is IStatusMessage status)
                    {
                        <br />
                        <span class="small">@status.StatusMessage</span>
                    }

                    @if (_errorsByCategory is not null)
                    {
                        <br />
                        <span class="small">
                            @foreach (var err in _errorsByCategory[handlerIdentifier])
                            {
                                <span class="me-1">@err.Level: @err.Count</span>
                            }
                        </span>
                    }
                </td>
                <td>
                    <button class="mbs-btn" @onclick="() => PauseService(svc)" disabled="@(svc.Status != Status.Running)">Pause</button>
                    <button class="mbs-btn" @onclick="() => ResumeService(svc)" disabled="@(svc.Status != Status.Paused)">Resume</button>
                </td>

                <td>                    
                    @{
                        var nextRunTime = GetScheduledJobNextRunTime(svc);
                        if (nextRunTime.HasValue)
                        {
                            <br />
                            <span class="small">Next Run:</span><br />
                            <span>@ConvertToLocalTime(nextRunTime.Value.UtcDateTime).ToString("yyyy-MM-dd HH:mm:ss") | @GetNextRunExpression(nextRunTime.Value)</span>
                        }
                        else if (svc is IQueueConsumerPerformance queueService && queueService.LastConsumedDateTimeUtc.HasValue)
                        {
                            <span class="small">Last Run:</span><br />
                            <span>@ConvertToLocalTime(queueService.LastConsumedDateTimeUtc.Value).ToString("yyyy-MM-dd HH:mm:ss") | @AgeExpression(queueService.LastConsumedDateTimeUtc.Value)</span>
                        }
                        else
                        {
                            <span>@ConvertToLocalTime(svc.StatusDateTimeUtc).ToString("yyyy-MM-dd HH:mm:ss") | @AgeExpression(svc.StatusDateTimeUtc)</span>
                        }
                    }
                </td>
                <td>
                    @if (svc.Exception is not null)
                    {
                        <code>
                            <pre>
                                @svc.Exception.StackTrace
                            </pre>
                        </code>
                    }
                </td>
            </tr>

            @if (isExpanded)
            {
                var logs = _logsByHandlerName[handlerIdentifier];                

                <tr class="mbs-log-row">
                    <td></td>
                    <td colspan="5">
                        <table class="mbs-logs-table">
                            <thead>
                                <tr>
                                    <th>Timestamp (UTC)</th>
                                    <th>Level</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!logs.Any())
                                {
                                    <tr>
                                        <td colspan="3">No recent logs found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var entry in logs)
                                    {
                                        <tr>
                                            <td>@ConvertToLocalTime(entry.TimestampUtc).ToString("yyyy-MM-dd HH:mm:ss") - @AgeExpression(entry.GetAge(DateTime.UtcNow))</td>
                                            <td>@entry.Level</td>
                                            <td>@entry.Message</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private readonly HashSet<string> _expandedServiceNames = [];
    private ILookup<string?, LogEntry>? _logsByHandlerName;
    private ILookup<string, (LogLevel Level, int Count)>? _errorsByCategory;
    private bool _isLocalTime = false;
    private string TimeColumnHeading => _isLocalTime ? "Updated (Local)" : "Updated (UTC)";

    [Parameter] public int MaxLogsPerCategory { get; set; } = 10;
    [Parameter] public int ErrorsLookMinutesBack { get; set; } = 30;
    [Parameter] public string? TimeZoneId { get; set; }

    private TimeZoneInfo? _timeZone;

    protected override void OnInitialized()
    {
        // Initialize timezone
        if (!string.IsNullOrWhiteSpace(TimeZoneId))
        {
            try
            {
                _timeZone = TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId);
                _isLocalTime = true;
            }
            catch (TimeZoneNotFoundException)
            {
                // If timezone is invalid, fall back to UTC
                _timeZone = null;
            }
        }

        _logsByHandlerName = LogQuery.GetLogsByHandlerName(maxResults: MaxLogsPerCategory);
        _errorsByCategory = LogQuery.GetErrorsByCategory(minutesBack: ErrorsLookMinutesBack);
    }

    private DateTime ConvertToLocalTime(DateTime utcDateTime)
    {
        if (_timeZone is null)
        {
            return utcDateTime;
        }

        return TimeZoneInfo.ConvertTime(utcDateTime, _timeZone);
    }

    private string GetStatusIcon(Status status) => status switch
    {
        Status.Running => "✔",
        Status.Paused => "⏸",
        Status.Crashed => "✖",
        _ => "?"
    };

    private static string GetStatusCssClass(Status status) => status switch
    {
        Status.Running => "mbs-status-running",
        Status.Paused => "mbs-status-paused",
        Status.Crashed => "mbs-status-crashed",
        _ => string.Empty
    };

    private static string GetServiceTypeIcon(ManagedBackgroundService service) => service switch
    {
        IQueueConsumerPerformance => "📋",
        _ => service.GetType().Name.EndsWith("Wrapper") ? "⏱" : ""
    };

    private static string GetServiceTypeLabel(ManagedBackgroundService service) => service switch
    {
        IQueueConsumerPerformance => "Queue Consumer",
        _ => service.GetType().Name.EndsWith("Wrapper") ? "Scheduled Job" : "Background Service"
    };

    private void ToggleLogs(string serviceType)
    {
        if (!_expandedServiceNames.Add(serviceType))
        {
            _expandedServiceNames.Remove(serviceType);
        }
    }

    private void PauseService(ManagedBackgroundService service)
    {
        service.Pause();
    }

    private void ResumeService(ManagedBackgroundService service)
    {
        service.Resume();
    }

     private static string AgeExpression(DateTime dateTime) => TimeSpanExpression(DateTime.UtcNow - dateTime) + " ago";

    private static string AgeExpression(TimeSpan age) => TimeSpanExpression(age) + " ago";

    private static string GetNextRunExpression(DateTimeOffset nextRunTime)
    {
        var timeUntilRun = nextRunTime - DateTimeOffset.UtcNow;

        if (timeUntilRun.TotalSeconds < 0)
        {
            return "now";
        }

        return "in " + TimeSpanExpression(timeUntilRun);
    }

    private static string TimeSpanExpression(TimeSpan timeSpan)
    {
        if (timeSpan.TotalSeconds < 60) return $"{(int)timeSpan.TotalSeconds} seconds";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} minutes";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} hours";
        return $"{(int)timeSpan.TotalDays} days";
    }

    private static string FormatRecurrencePattern(RecurrencePattern pattern)
    {
        var parts = new List<string>();

        if (pattern.Period.HasValue)
        {
            parts.Add($"Every {FormatTimeSpan(pattern.Period.Value)}");
        }

        if (pattern.WeekDays.Length > 0)
        {
            var days = string.Join(", ", pattern.WeekDays.Distinct().OrderBy(d => (int)d).Select(d => d.ToString().Substring(0, 3)));
            parts.Add($"Weekly on {days}");
        }

        if (pattern.MonthDays.Length > 0)
        {
            var days = string.Join(", ", pattern.MonthDays.Distinct().OrderBy(d => d).Select(d => d > 0 ? $"day {d}" : $"day {d} (from end)"));
            parts.Add($"Monthly on {days}");
        }

        if (pattern.YearDays.Length > 0)
        {
            var days = string.Join(", ", pattern.YearDays.Distinct().OrderBy(d => d).Select(d => d > 0 ? $"day {d}" : $"day {d} (from end)"));
            parts.Add($"Yearly on {days}");
        }

        if (pattern.Times.Length > 0 && !(pattern.Times.Length == 1 && pattern.Times[0] == TimeOnly.MinValue))
        {
            var times = string.Join(", ", pattern.Times.Distinct().OrderBy(t => t.Ticks).Select(t => t.ToString("HH:mm:ss")));
            parts.Add($"at {times}");
        }

        if (pattern.Between.HasValue)
        {
            parts.Add($"between {pattern.Between.Value.Start:HH:mm:ss} and {pattern.Between.Value.End:HH:mm:ss}");
        }

        return parts.Any() ? string.Join(" ", parts) : "Every midnight UTC";
    }

    private static string FormatTimeSpan(TimeSpan span)
    {
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalDays}d";
    }

    private RecurrencePattern? GetScheduledJobPattern(string handlerIdentifier)
    {
        if (ScheduledJobRegistry is null) return null;

        return ScheduledJobRegistry.Jobs
            .FirstOrDefault(j => j.JobType.Name == handlerIdentifier)
            ?.Pattern;
    }

    private DateTimeOffset? GetScheduledJobNextRunTime(ManagedBackgroundService service)
    {
        // Try to get the NextRunTime property via reflection if it's a scheduled wrapper
        var nextRunTimeProp = service.GetType().GetProperty("NextRunTime");
        if (nextRunTimeProp is not null)
        {
            var value = nextRunTimeProp.GetValue(service);
            if (value is DateTimeOffset dateTimeOffset)
            {
                return dateTimeOffset;
            }
        }

        return null;
    }
}
