@using ManagedBackgroundServices.Abstractions
@using ManagedBackgroundServices.Abstractions.Infrastructure
@using ManagedBackgroundServices.Abstractions.Logging
@using ManagedBackgroundServices.Abstractions.Queues
@using Microsoft.Extensions.Logging
@inject IManagedBackgroundServiceProvider BackgroundServices
@inject IInMemoryLogQuery LogQuery

@if (_logsByCategory is null) return;

<table class="mbs-dashboard-table">
    <thead>
        <tr>
            <th></th>
            <th>Service</th>
            <th>Status</th>
            <th>@TimeColumnHeading</th>
            <th>Controls</th>
            <th>Exception</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var svc in BackgroundServices.Services)
        {
            var serviceType = svc.GetType().Name;
            var serviceCategory = svc.GetType().FullName!;
            var isExpanded = _expandedServiceNames.Contains(serviceType);

            <tr>
                <td>
                    <button class="mbs-btn mbs-expand-btn" @onclick="() => ToggleLogs(serviceType)">@(isExpanded ? "Hide" : "Show") logs</button>
                </td>
                <td>@serviceType</td>
                <td>
                    <span class="mbs-status-chip @GetStatusCssClass(svc.Status)">
                        <span class="mbs-status-icon" aria-hidden="true">@GetStatusIcon(svc.Status)</span>
                        @svc.Status
                    </span>

                    @if (svc is IQueueConsumerPerformance queueSvc)
                    {
                        <br />
                        <span class="small">@queueSvc.ConsumeRate.ToString("n1") / @TimeSpanExpression(queueSvc.ConsumeRateSpan)</span>
                    }

                    @if (svc is INextRun nextRun)
                    {
                        <br />
                        <span class="small">runs <strong>@GetNextRunExpression(nextRun.NextRunTime)</strong> at @ConvertToLocalTime(nextRun.NextRunTime.DateTime).ToString("yyyy-MM-dd HH:mm:ss")</span>
                    }

                    @if (svc is IStatusMessage status)
                    {
                        <br />
                        <span class="small">@status.StatusMessage</span>
                    }

                    @if (_errorsByCategory is not null)
                    {
                        <br />
                        <span class="small">
                            @foreach (var err in _errorsByCategory[serviceCategory])
                            {
                                <span class="me-1">@err.Level: @err.Count</span>
                            }
                        </span>
                    }
                </td>
                <td>@ConvertToLocalTime(svc.StatusDateTimeUtc).ToString("yyyy-MM-dd HH:mm:ss") | @AgeExpression(svc.StatusDateTimeUtc)</td>
                <td>
                    <button class="mbs-btn" @onclick="() => PauseService(svc)" disabled="@(svc.Status != Status.Running)">Pause</button>
                    <button class="mbs-btn" @onclick="() => ResumeService(svc)" disabled="@(svc.Status != Status.Paused)">Resume</button>
                </td>
                <td>
                    @if (svc.Exception is not null)
                    {
                        <code>
                            <pre>
                                @svc.Exception.StackTrace
                            </pre>
                        </code>
                    }
                </td>
            </tr>

            @if (isExpanded)
            {
                var logs = _logsByCategory[serviceCategory];                

                <tr class="mbs-log-row">
                    <td></td>
                    <td colspan="5">
                        <table class="mbs-logs-table">
                            <thead>
                                <tr>
                                    <th>Timestamp (UTC)</th>
                                    <th>Level</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!logs.Any())
                                {
                                    <tr>
                                        <td colspan="3">No recent logs found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var entry in logs)
                                    {
                                        <tr>
                                            <td>@ConvertToLocalTime(entry.TimestampUtc).ToString("yyyy-MM-dd HH:mm:ss") - @AgeExpression(entry.GetAge(DateTime.UtcNow))</td>
                                            <td>@entry.Level</td>
                                            <td>@entry.Message</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private readonly HashSet<string> _expandedServiceNames = [];
    private ILookup<string, LogEntry>? _logsByCategory;
    private ILookup<string, (LogLevel Level, int Count)>? _errorsByCategory;
    private bool _isLocalTime = false;
    private string TimeColumnHeading => _isLocalTime ? "Updated (Local)" : "Updated (UTC)";

    [Parameter] public int MaxLogsPerCategory { get; set; } = 10;
    [Parameter] public int ErrorsLookMinutesBack { get; set; } = 30;
    [Parameter] public string? TimeZoneId { get; set; }

    private TimeZoneInfo? _timeZone;

    protected override void OnInitialized()
    {
        // Initialize timezone
        if (!string.IsNullOrWhiteSpace(TimeZoneId))
        {
            try
            {
                _timeZone = TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId);
                _isLocalTime = true;
            }
            catch (TimeZoneNotFoundException)
            {
                // If timezone is invalid, fall back to UTC
                _timeZone = null;
            }
        }

        _logsByCategory = LogQuery.GetLogsByCategory(maxPerCategory: MaxLogsPerCategory);
        _errorsByCategory = LogQuery.GetErrorsByCategory(minutesBack: ErrorsLookMinutesBack);
    }

    private DateTime ConvertToLocalTime(DateTime utcDateTime)
    {
        if (_timeZone is null)
        {
            return utcDateTime;
        }

        return TimeZoneInfo.ConvertTime(utcDateTime, _timeZone);
    }

    private string GetStatusIcon(Status status) => status switch
    {
        Status.Running => "✔",
        Status.Paused => "⏸",
        Status.Crashed => "✖",
        _ => "?"
    };

    private static string GetStatusCssClass(Status status) => status switch
    {
        Status.Running => "mbs-status-running",
        Status.Paused => "mbs-status-paused",
        Status.Crashed => "mbs-status-crashed",
        _ => string.Empty
    };

    private void ToggleLogs(string serviceType)
    {
        if (!_expandedServiceNames.Add(serviceType))
        {
            _expandedServiceNames.Remove(serviceType);
        }
    }

    private void PauseService(ManagedBackgroundService service)
    {
        service.Pause();
    }

    private void ResumeService(ManagedBackgroundService service)
    {
        service.Resume();
    }

     private static string AgeExpression(DateTime dateTime) => TimeSpanExpression(DateTime.UtcNow - dateTime) + " ago";

    private static string AgeExpression(TimeSpan age) => TimeSpanExpression(age) + " ago";

    private static string GetNextRunExpression(DateTimeOffset nextRunTime)
    {
        var timeUntilRun = nextRunTime - DateTimeOffset.UtcNow;

        if (timeUntilRun.TotalSeconds < 0)
        {
            return "now";
        }

        return "in " + TimeSpanExpression(timeUntilRun);
    }

    private static string TimeSpanExpression(TimeSpan timeSpan)
    {
        if (timeSpan.TotalSeconds < 60) return $"{(int)timeSpan.TotalSeconds} seconds";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} minutes";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} hours";
        return $"{(int)timeSpan.TotalDays} days";
    }
}
